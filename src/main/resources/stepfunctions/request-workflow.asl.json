            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "WorkflowFailed"
        }
      ],
      "Next": "ManualReviewQueued"
    },
    "CancelByAdmin": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${LifecycleLambdaArn}",
        "Payload": {
          "operation": "cancelIfActive",
          "executionId.$": "$$.Execution.Id",
          "requestId.$": "$.persistedInvoke.Payload.requestId"
        }
      },
      "ResultPath": "$.cancelInvoke",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "WorkflowFailed"
        }
      ],
      "Next": "Terminated"
    },
    "ManualReview": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ManualReviewLambdaArn}",
        "Payload": {
          "operation": "queueManualReview",
          "executionId.$": "$$.Execution.Id",
          "requestId.$": "$.persistedInvoke.Payload.requestId"
        }
      },
      "ResultPath": "$.reviewInvoke",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "WorkflowFailed"
        }
      ],
      "Next": "ManualReviewQueued"
    },
    "FlaggedForReview": {
      "Type": "Succeed"
    },
    "ManualReviewQueued": {
      "Type": "Succeed"
    },
    "Terminated": {
      "Type": "Succeed"
    },
    "InvalidSubmission": {
      "Type": "Fail",
      "Error": "InvalidSubmission",
      "Cause": "Workflow input, task output, or dependency failed"
    },
    "MalformedClassification": {
      "Type": "Fail",
      "Error": "MalformedClassification",
      "Cause": "Workflow input, task output, or dependency failed"
    },
    "MalformedPersistence": {
      "Type": "Fail",
